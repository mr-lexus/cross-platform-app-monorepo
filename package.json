{
  "name": "ibit-cross-platform-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "ios": "npm run ios --workspace=@ibit/mobile",
    "android": "npm run android --workspace=@ibit/mobile",
    "start": "npm run start --workspace=@ibit/mobile",
    "web": "npm run dev --workspace=@ibit/web",
    "build:web": "npm run build --workspace=@ibit/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21",
    "typescript": "~5.9",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3"
  }
}
